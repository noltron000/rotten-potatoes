<!--
	Main HBS Rendering Template
	views/layouts/main.hbs
-->

<!doctype html>
<html>
	<head>
		<meta charset='utf-8'>
		<meta name='viewport' content='width=device-width, initial-scale=1'>
		<title>{{#if title}}{{title}} | {{/if}}Rotten Potatoes</title>
		<link
			rel='stylesheet'
			href='{{url '/css/reset.css'}}'
		/>
		<link
			rel='stylesheet'
			href='{{url '/css/styles.css'}}'
		/>
	</head>

	<body data-base-path='{{basePath}}'>
		<header class='site-header'>
			<a class='site-brand' href='{{url '/'}}'>Rotten Potatoes</a>
			<nav aria-label='Main navigation'>
				<a href='{{url '/'}}'>Home</a>
				<a href='{{url '/movies?sortBy=now-playing'}}'>Now Playing</a>
				<a href='{{url '/movies?sortBy=popular'}}'>Popular</a>
				<a href='{{url '/movies?sortBy=top-rated'}}'>Top Rated</a>
				<a href='{{url '/movies?sortBy=upcoming'}}'>Upcoming</a>
			</nav>
		</header>

		<div class='page-shell'>
			{{!-- This contains all other page information. --}}
			{{{body}}}
		</div>

		<script type='module' src='{{url '/js/movie.mjs'}}'></script>
		{{#if devMode}}
		<script>
			const developmentEvents = new EventSource('{{url '/__dev/reload'}}')
			developmentEvents.onmessage = () => window.location.reload()
		</script>
		{{/if}}
	</body>
</html>
